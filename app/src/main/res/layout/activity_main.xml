<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/appBackground"
    android:orientation="vertical"
    android:paddingLeft="20dp"
    android:paddingTop="16dp"
    android:paddingRight="20dp"
    android:paddingBottom="12dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Enter Text"
        android:textColor="?attr/appText"
        android:textSize="32sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Сообщения и рукописные заметки для часов"
        android:textColor="?attr/appSecondaryText"
        android:textSize="14sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="16dp"
        android:background="@drawable/bg_segment"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="4dp">

        <TextView
            android:id="@+id/tabSend"
            style="@style/Tab"
            android:text="Отправка" />

        <TextView
            android:id="@+id/tabHistory"
            style="@style/Tab"
            android:text="История" />

        <TextView
            android:id="@+id/tabSettings"
            style="@style/Tab"
            android:text="Настройки" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_weight="1">

        <!-- ОТПРАВКА -->
        <ScrollView
            android:id="@+id/pageSend"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingBottom="16dp">

                <TextView
                    style="@style/Section"
                    android:text="ЗАГОЛОВОК" />

                <EditText
                    android:id="@+id/titleInput"
                    style="@style/Field"
                    android:hint="Например, Заметка"
                    android:inputType="textCapSentences"
                    android:maxLines="1" />

                <TextView
                    style="@style/Section"
                    android:layout_marginTop="22dp"
                    android:text="СООБЩЕНИЕ" />

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <EditText
                        android:id="@+id/messageInput"
                        style="@style/Field"
                        android:gravity="top"
                        android:hint="Введите текст"
                        android:inputType="textMultiLine|textCapSentences"
                        android:minLines="6"
                        android:paddingRight="58dp" />

                    <Button
                        android:id="@+id/clearMessageButton"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:layout_gravity="top|end"
                        android:layout_marginTop="8dp"
                        android:layout_marginRight="8dp"
                        android:background="@drawable/bg_clear_button"
                        android:contentDescription="Очистить сообщение"
                        android:gravity="center"
                        android:minWidth="0dp"
                        android:minHeight="0dp"
                        android:padding="0dp"
                        android:stateListAnimator="@null"
                        android:text="×"
                        android:textColor="?attr/appText"
                        android:textSize="23sp" />
                </FrameLayout>

                <Button
                    android:id="@+id/sendButton"
                    style="@style/BtnPrimary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="Отправить на часы" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/pickButton"
                        style="@style/BtnSecondary"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginRight="5dp"
                        android:layout_weight="1"
                        android:text="Фото" />

                    <Button
                        android:id="@+id/inkButton"
                        style="@style/BtnSecondary"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="5dp"
                        android:layout_weight="1"
                        android:text="Рукопись" />
                </LinearLayout>

                <ImageView
                    android:id="@+id/preview"
                    android:layout_width="match_parent"
                    android:layout_height="170dp"
                    android:layout_marginTop="14dp"
                    android:background="@drawable/bg_input"
                    android:padding="6dp"
                    android:scaleType="fitCenter"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/status"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:background="@drawable/bg_input"
                    android:padding="14dp"
                    android:text="Готово к работе"
                    android:textColor="?attr/appText"
                    android:textSize="14sp" />
            </LinearLayout>
        </ScrollView>

        <!-- ИСТОРИЯ -->
        <LinearLayout
            android:id="@+id/pageHistory"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:visibility="gone">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="12dp"
                android:layout_weight="1">

                <ListView
                    android:id="@+id/historyList"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:divider="@null"
                    android:dividerHeight="10dp"
                    android:scrollbars="none" />

                <TextView
                    android:id="@+id/historyEmpty"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:text="Пока ничего не отправлено"
                    android:textColor="?attr/appSecondaryText"
                    android:textSize="16sp" />
            </FrameLayout>

            <Button
                android:id="@+id/clearHistoryButton"
                style="@style/BtnSecondary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="Очистить историю" />
        </LinearLayout>

        <!-- НАСТРОЙКИ -->
        <ScrollView
            android:id="@+id/pageSettings"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scrollbars="none"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingBottom="16dp">

                <TextView
                    style="@style/Section"
                    android:text="ТЕМА ПРИЛОЖЕНИЯ" />

                <RadioGroup
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <RadioButton
                        android:id="@+id/themeLight"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Светлая"
                        android:textColor="?attr/appText" />

                    <RadioButton
                        android:id="@+id/themeDark"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Тёмная"
                        android:textColor="?attr/appText" />
                </RadioGroup>

                <TextView
                    style="@style/Section"
                    android:text="ДЛИНА ОДНОГО УВЕДОМЛЕНИЯ" />

                <TextView
                    android:id="@+id/chunkLabel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="120 символов"
                    android:textColor="?attr/appText"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <SeekBar
                    android:id="@+id/chunkSeek"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:progressTint="?attr/appText"
                    android:thumbTint="?attr/appText" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:layout_marginBottom="12dp"
                    android:text="Длинный текст делится на части, чтобы каждая целиком помещалась на экране часов, без «…» в конце. Нажмите кнопку ниже: на часы придёт тестовое уведомление с числами. Последнее число, которое видно до «…», и есть ваша длина. Поставьте ползунок на это значение."
                    android:textColor="?attr/appSecondaryText"
                    android:textSize="13sp" />

                <Button
                    android:id="@+id/calibrateButton"
                    style="@style/BtnSecondary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Тест: сколько влезает на часы" />

                <TextView
                    style="@style/Section"
                    android:text="РАСПОЗНАВАНИЕ ПОЧЕРКА В ОБЛАКЕ" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="10dp"
                    android:text="Рукописный текст на фото распознаёт OpenAI. Вставьте свой ключ API с platform.openai.com. Фото отправляется в OpenAI для распознавания; использование API оплачивается отдельно. Без ключа работает локальное распознавание, но почерк оно читает хуже."
                    android:textColor="?attr/appSecondaryText"
                    android:textSize="13sp" />

                <EditText
                    android:id="@+id/keyInput"
                    style="@style/Field"
                    android:hint="Ключ OpenAI API (sk-…)"
                    android:inputType="textPassword"
                    android:maxLines="1" />

                <Button
                    android:id="@+id/saveKeyButton"
                    style="@style/BtnPrimary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="Сохранить ключ" />

                <TextView
                    android:id="@+id/keyStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:textColor="?attr/appText"
                    android:textSize="13sp" />

                <TextView
                    style="@style/Section"
                    android:text="СИСТЕМА" />

                <Button
                    android:id="@+id/systemSettingsButton"
                    style="@style/BtnSecondary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Настройки уведомлений Android" />
            </LinearLayout>
        </ScrollView>
    </FrameLayout>
</LinearLayout>
